<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.edgar</groupId>
        <artifactId>lifeos</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>lifeos-boot</artifactId>
    <name>LifeOS Boot</name>
    <description>启动模块：负责装配所有模块、配置和资源文件。</description>

    <dependencies>
        <!-- 内部模块 -->
        <dependency>
            <groupId>com.edgar</groupId>
            <artifactId>lifeos-kernel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edgar</groupId>
            <artifactId>lifeos-contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edgar</groupId>
            <artifactId>lifeos-module-identity</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edgar</groupId>
            <artifactId>lifeos-module-capture</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edgar</groupId>
            <artifactId>lifeos-module-planning</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edgar</groupId>
            <artifactId>lifeos-module-health</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edgar</groupId>
            <artifactId>lifeos-module-timeline</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edgar</groupId>
            <artifactId>lifeos-module-publication</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edgar</groupId>
            <artifactId>lifeos-module-search</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edgar</groupId>
            <artifactId>lifeos-module-insight</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edgar</groupId>
            <artifactId>lifeos-module-notification</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edgar</groupId>
            <artifactId>lifeos-module-agent</artifactId>
        </dependency>
        <dependency>
            <groupId>com.edgar</groupId>
            <artifactId>lifeos-integration</artifactId>
        </dependency>

        <!-- Web MVC：所有 Controller 的基础 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- MyBatis + JDBC：所有 Mapper 的基础 -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>

        <!-- MySQL 驱动：运行时连接 MySQL 8.x -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
      等 LifeOsApplication 主类创建后，再打开下面的打包插件：
      <build>
          <plugins>
              <plugin>
                  <groupId>org.springframework.boot</groupId>
                  <artifactId>spring-boot-maven-plugin</artifactId>
              </plugin>
          </plugins>
      </build>
    -->
</project>
