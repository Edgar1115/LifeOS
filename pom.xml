<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>com.edgar</groupId>
    <artifactId>lifeos</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>LifeOS</name>
    <description>LifeOS - Personal Life Management and AI Agent System</description>

    <modules>
        <module>lifeos-kernel</module>
        <module>lifeos-contracts</module>
        <module>lifeos-module-identity</module>
        <module>lifeos-module-capture</module>
        <module>lifeos-module-planning</module>
        <module>lifeos-module-health</module>
        <module>lifeos-module-timeline</module>
        <module>lifeos-module-publication</module>
        <module>lifeos-module-search</module>
        <module>lifeos-module-insight</module>
        <module>lifeos-module-notification</module>
        <module>lifeos-module-agent</module>
        <module>lifeos-integration</module>
        <module>lifeos-boot</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- 本机离线仓库中可用的 MyBatis Starter 版本 -->
        <mybatis-spring-boot.version>4.0.1</mybatis-spring-boot.version>
        <!-- 规格书要求 MySQL 8.x，本机离线仓库可用 8.3.0 -->
        <mysql.version>8.3.0</mysql.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 外部依赖版本锁定（Spring Boot 未管理的才需要） -->
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis-spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql.version}</version>
            </dependency>

            <!-- LifeOS 内部模块版本锁定：所有子模块引用时无需再写 version -->
            <dependency>
                <groupId>com.edgar</groupId>
                <artifactId>lifeos-kernel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.edgar</groupId>
                <artifactId>lifeos-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.edgar</groupId>
                <artifactId>lifeos-module-identity</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.edgar</groupId>
                <artifactId>lifeos-module-capture</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.edgar</groupId>
                <artifactId>lifeos-module-planning</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.edgar</groupId>
                <artifactId>lifeos-module-health</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.edgar</groupId>
                <artifactId>lifeos-module-timeline</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.edgar</groupId>
                <artifactId>lifeos-module-publication</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.edgar</groupId>
                <artifactId>lifeos-module-search</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.edgar</groupId>
                <artifactId>lifeos-module-insight</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.edgar</groupId>
                <artifactId>lifeos-module-notification</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.edgar</groupId>
                <artifactId>lifeos-module-agent</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.edgar</groupId>
                <artifactId>lifeos-integration</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <!-- 保留参数名，Spring 默认依赖 -parameters -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <!--
                  Spring Boot 打包插件统一放在 pluginManagement 里，
                  哪个模块需要打可执行 jar，就在那个模块的 build/plugins 里声明它。
                  目前 lifeos-boot 还没有主类，暂时不启用。
                -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>