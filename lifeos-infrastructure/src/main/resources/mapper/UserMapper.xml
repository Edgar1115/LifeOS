<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.edgar.lifeos.infrastructure.persistence.mybatis.user.UserMapper">

    <resultMap id="userResultMap" type="com.edgar.lifeos.infrastructure.persistence.mybatis.user.UserDO">
        <id column="id" property="id"/>
        <result column="openid" property="openid"/>
        <result column="unionid" property="unionid"/>
        <result column="nickname" property="nickname"/>
        <result column="avatar_url" property="avatarUrl"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="allColumns">
        id, openid, unionid, nickname, avatar_url, status, created_at, updated_at
    </sql>

    <insert id="insert" parameterType="com.edgar.lifeos.infrastructure.persistence.mybatis.user.UserDO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO life_user (openid, unionid, nickname, avatar_url, status, created_at, updated_at)
        VALUES (#{openid}, #{unionid}, #{nickname}, #{avatarUrl}, #{status}, #{createdAt}, #{updatedAt})
    </insert>

    <select id="selectById" resultMap="userResultMap">
        SELECT <include refid="allColumns"/>
        FROM life_user
        WHERE id = #{id}
    </select>

    <select id="selectByOpenid" resultMap="userResultMap">
        SELECT <include refid="allColumns"/>
        FROM life_user
        WHERE openid = #{openid}
    </select>

    <select id="selectAll" resultMap="userResultMap">
        SELECT <include refid="allColumns"/>
        FROM life_user
    </select>

    <update id="update">
        UPDATE life_user
        SET openid      = #{openid},
            unionid     = #{unionid},
            nickname    = #{nickname},
            avatar_url  = #{avatarUrl},
            status      = #{status},
            updated_at  = #{updatedAt}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM life_user
        WHERE id = #{id}
    </delete>

</mapper>